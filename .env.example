# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-key-here

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/mayank_portfolio?schema=public"
DIRECT_URL="postgresql://username:password@localhost:5432/mayank_portfolio?schema=public"

# Authentication Providers
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Payment Processing
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# Email Service
SENDGRID_API_KEY=SG.your-sendgrid-api-key
FROM_EMAIL=contact@mayank.com

# Media Storage
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Analytics
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Booking Integration
CALENDLY_WEBHOOK_SECRET=your-calendly-webhook-secret
CALENDLY_LINK=https://calendly.com/your-calendly-link

# Development
NODE_ENV=development